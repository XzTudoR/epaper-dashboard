# --- Sensitive Configuration & Credentials ---
config.h
secrets.h
*.local.h
.env
.env.*
*.secret

# --- Operating System Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

