build/
bin/
*.bin
*.elf
*.hex
*.o
*.a
*.d
.pio/
.pioenvs/
.piolibdeps/

# --- IDEs & Editors ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*~

# --- Logs & Crash Dumps ---
*.log
core
